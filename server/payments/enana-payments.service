[Unit]
Description=enana confirmed TRC20 receipt scanner
After=network-online.target enana-pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=enana
Group=enana
WorkingDirectory=/opt/enana-cc/payments
Environment=ENANA_BILLING_CONFIG=/etc/enana/billing.json
ExecStart=/usr/bin/node /opt/enana-cc/payments/scanner.js
Restart=on-failure
RestartSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enana-cc/payments
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
