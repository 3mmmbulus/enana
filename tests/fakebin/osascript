#!/bin/bash
# Never allow native administrator scripting to change the real Mac in tests.
echo "osascript $*" >> "$FAKE_STATE/calls.log"
case ${3:-} in
  */appicon.js) exec /usr/bin/osascript "$@" ;; # Read/render fixture icons only.
  */proxy-state.js)
    case ${4:-} in
      snapshot) printf '{"schema":1,"services":{}}\n' ;;
      check) [ ! -f "$FAKE_STATE/sysproxy-on" ] && echo clean || echo changed ;;
      restore) rm -f "$FAKE_STATE/sysproxy-on"; echo 'Proxy preferences restored' ;;
      *) exit 1 ;;
    esac ;;
  *) echo 'Refusing real administrator scripting in fixture' >&2; exit 1 ;;
esac
