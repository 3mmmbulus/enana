#!/bin/bash
# Never allow native administrator scripting to change the real Mac in tests.
#   「do shell script … with administrator privileges」(原生管理员密码框) 用 FAKE_DIALOG 模拟:
#     (默认) 用户输入了密码 → 在管理员环境 (FAKE_ADMIN=1) 里执行命令   cancel → 用户点了取消 (真实错误文字)   denied → 当前账户不是管理员
echo "osascript $*" >> "$FAKE_STATE/calls.log"
. "$(dirname "$0")/rootpaths.sh"       # 以 root 运行的命令里写死的路径换成沙箱 (见 rootpaths.sh)
if [ "${1:-}" = -e ]; then
  case ${2:-} in
    "do shell script \""*"\" with administrator privileges")
      case ${FAKE_DIALOG:-ok} in
        cancel) echo "execution error: User canceled. (-128)" >&2; exit 1 ;;
        denied) echo "execution error: Not authorized to send Apple events to System Events. (-1743)" >&2; exit 1 ;;
      esac
      s=${2#"do shell script \""}; s=${s%"\" with administrator privileges"}
      cmd=$(printf '%s' "$s" | perl -pe 's/\\([\\"])/$1/g')      # 还原 AppleScript 字符串转义 (一次遍历: \\ → \, \" → ")
      cmd=$(printf '%s' "$cmd" | rootpaths_rewrite)
      FAKE_ADMIN=1 bash -c "$cmd"; exit $? ;;
  esac
fi
case ${3:-} in
  */appicon.js) exec /usr/bin/osascript "$@" ;; # Read/render fixture icons only.
  */proxy-state.js|*/proxy-state-[0-9]*.js)      # lib 里的 / root 临时目录里 inband 的那份 / libexec 里的 root 副本 (proxy-state-<uid>.js)
    case ${4:-} in
      snapshot) printf '{"schema":1,"services":{}}\n' ;;
      check) [ ! -f "$FAKE_STATE/sysproxy-on" ] && echo clean || echo changed ;;
      restore)
        # 记下运行的是哪一份脚本 (字节的 SHA-256) 和有没有收据参数, 然后照旧; 收据不是 snapshot 那种 JSON 时像真的一样失败, 什么都不改
        printf 'proxy-state restore js=%s receipt=%s\n' "$(/usr/bin/shasum -a 256 < "$3" | /usr/bin/awk '{print $1}')" "$([ "$#" -ge 6 ] && echo yes || echo no)" >> "$FAKE_STATE/calls.log"
        if [ "$#" -ge 6 ] && ! /usr/bin/perl -MJSON::PP -e 'open(my $f, "<", $ARGV[0]) or exit 1; local $/; my $d = eval { JSON::PP->new->decode(scalar <$f>) }; exit((ref $d eq "HASH" && defined $d->{schema} && $d->{schema} eq "1" && ref $d->{services} eq "HASH") ? 0 : 1)' "$6"; then
          echo "$3: execution error: Error: Invalid proxy receipt (-2700)" >&2; exit 1
        fi
        rm -f "$FAKE_STATE/sysproxy-on"; echo 'Proxy preferences restored' ;;
      *) exit 1 ;;
    esac ;;
  *) echo 'Refusing real administrator scripting in fixture' >&2; exit 1 ;;
esac
